ription\" content=\"Resumo da edição de sexta-feira, 2 de outubro de 2026, de O Estado de S. Paulo, em ordem de destaque: tecnologia e IA, economia e mercados, política e demais temas.\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Encode+Sans+Expanded:wght@400;500;600;700;800&family=Encode+Sans:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n/* ============================================================\n   RESUMO DE JORNAL · deck HTML de arquivo único\n   Linguagem visual herdada do modelo \"Walk Challenge 2026\":\n   palco 1600x900 escalável, capa e divisórias escuras com campo\n   animado, slides claros com KPIs, cards, barras e linha do tempo.\n   ============================================================ */\n*,*::before,*::after{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\n:root{\n  --dk1:#282B34; --dk2:#002855; --lt2:#C3D7EE;\n  --accent1:#243782; --accent3:#C3D7EE; --accent5:#D35D00; --accent6:#43AAA0; --hlink:#0082FB;\n  --font-heading:'Encode Sans Expanded','Encode Sans',Arial,sans-serif;\n  --font-body:'Encode Sans',Arial,sans-serif;\n  --field:#00163C; --paper:#FFFFFF; --mist:#F3F6FB; --mist-2:#E8EEF8; --rule:#D8E1EF;\n  --ink:#010834; --ink-soft:#4E5A75; --ink-faint:#7D879B;\n  /* paleta categórica validada do modelo (fundo claro) */\n  --c1:#2A54B5; --c2:#00968C; --c3:#D35D00; --c4:#8E5BC7; --c-mute:#AFBBD1;\n  --grid:#E4EAF4; --axis:#9AA6BC; --num1:#243782; --pos:#0A7F76;\n}\n/* modo escuro: degraus próprios, não uma inversão */\nhtml[data-theme-mode=\"dark\"]{\n  --paper:#061B3E; --mist:#0C2650; --mist-2:#123061; --rule:#1E3D70;\n  --ink:#EAF1FB; --ink-soft:#A9BEDD; --ink-faint:#7F96BA;\n  --c1:#5C82DC; --c2:#12A899; --c3:#D0762A; --c4:#9C6FD8; --c-mute:#3C5580;\n  --grid:#173359; --axis:#5A7399; --num1:#8FB0EE; --pos:#3ED0BF;\n}\nhtml,body{margin:0;padding:0;