0deg,#00122F 0%,rgba(0,20,52,.94) 30%,rgba(0,26,64,.66) 54%,rgba(0,34,78,.28) 76%,rgba(0,40,88,.08) 100%)}\n56\t.slide[data-theme=\"dark\"]>*{position:relative;z-index:2}\n57\t.slide[data-theme=\"light\"]{background:var(--paper);color:var(--ink)}\n58\t.slide[data-theme=\"light\"]::before{content:\"\";position:absolute;inset:0;pointer-events:none;z-index:0;\n59\t  background:radial-gradient(58% 80% at 100% 0%,rgba(195,215,238,.34) 0%,rgba(195,215,238,0) 62%),\n60\t             radial-gradient(46% 62% at 0% 100%,rgba(195,215,238,.24) 0%,rgba(195,215,238,0) 60%)}\n61\thtml[data-theme-mode=\"dark\"] .slide[data-theme=\"light\"]::before{\n62\t  background:radial-gradient(58% 80% at 100% 0%,rgba(92,130,220,.16) 0%,rgba(92,130,220,0) 62%),\n63\t             radial-gradient(46% 62% at 0% 100%,rgba(18,168,153,.10) 0%,rgba(18,168,153,0) 60%)}\n64\t.slide[data-theme=\"light\"]>*{position:relative;z-index:2}\n65\t\n66\t/* entrada escalonada: estado de repouso é VISÍVEL; o oculto vive só nos keyframes */\n67\t.slide.active .rv{animation:rvIn .5s cubic-bezier(.22,.7,.2,1) both}\n68\t.slide.active .rv:nth-child(1){animation-delay:.05s}.slide.active .rv:nth-child(2){animation-delay:.12s}\n69\t.slide.active .rv:nth-child(3){animation-delay:.19s}.slide.active .rv:nth-child(4){animation-delay:.26s}\n70\t.slide.active .rv:nth-child(5){animation-delay:.33s}.slide.active .rv:nth-child(6){animation-delay:.40s}\n71\t@keyframes rvIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}\n72\t.slide.active .fan>*{animation:fanIn .42s cubic-bezier(.22,.7,.2,1) both}\n73\t@keyframes fanIn{from{opacity:0;transform:translateY(14px) scale(.985)}to{opacity:1;transform:none}}\n74\t.slide.active .fan>*:nth-child(1){animation-delay:.14s}.slide.active .fan>*:nth-child(2){animation-delay:.18s}\n75\t.slide.active .fan>*:nth-child(3){animation-delay:.22s}.slide.active .fan>*:nth-child(4){animation-delay:.26s}\n76\t.slide.active .fan>*:nth-child(5){animation-delay:.30s}.slide.active .fan>*:nth-child(6){animation-delay:.34s}\n77\t.slide.active .fan>*:nth-child(7){animation-delay:.38s}.slide.active .fan>*:nth-child(8){animation-delay:.42s}\n78\t.slide.active .fan>*:nth-child(n+9){animation-delay:.46s}\n79\tbody.no-motion .slide.active .rv,body.no-motion .slide.active .fan>*{animation:none}\n80\t.deck::after{content:\"\";position:absolute;inset:0;pointer-events:none;z-index:40;opacity:.035;\n81\t  background-image:url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3'/></filter><rect width='120' height='120' filter='url(%23n)'/></svg>\")}\n82\t\n83\t/* ---------- 2 · CROMO: marca, navegação, progresso, rodapé ---------- */\n84\t.brand{position:absolute;top:22px;left:50%;transform:translateX(-50%);z-index:55;pointer-events:none;\n85\t  font-family:var(--font-heading);font-size:11px;font-weight:700;letter-spacing:.32em;text-transform:uppercase;\n86\t  color:rgba(195,215,238,.72);display:flex;align-items:center;gap:10px;white-space:nowrap}\n87\t.brand i{width:7px;height:7px;border-radius:50%;background:var(--accent5);display:block}\n88\t.brand.on-light{color:#46526E}\n89\t.nav{position:fixed;bottom:14px;left:50%;transform:translateX(-50%);z-index:62;display:flex;align-items:center;gap:13px;\n90\t  padding:7px 15px;border-radius:999px;background:rgba(4,16,42,.74);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);\n91\t  border:1px solid rgba(195,215,238,.2);color:#DCE7F7;font-family:var(--font-body);font-size:11px;letter-spacing:.06em;\n92\t  opacity:.55;transition:opacity .3s ease}\n93\t.nav:hover,.nav:focus-within{opacity:1}\n94\t.dots{display:flex;gap:5px;align-items:center}\n95\t.dot{width:7px;height:7px;border-radius:50%;border:0;padding:0;cursor:pointer;background:rgba(195,215,238,.34);\n96\t  transition:transform .25s ease,background .25s ease}\n97\t.dot:hover{background:var(--accent3);transform:scale(1.35)}\n98\t.dot.sec{background:rgba(67,170,160,.6)}\n99\t.dot.on{background:var(--accent5);transform:scale(1.5)}\n100\t.nbtn{background:transparent;border:1px solid rgba(195,215,238,.45);color:inherit;border-radius:999px;min-width:30px;height:24px;\n101\t  padding:0 8px;cursor:pointer;font-size:11px;font-weight:600;font-family:var(--font-body);opacity:.85;transition:opacity .2s,background .2s}\n102\t.nbtn:hover{opacity:1;background:rgba(195,215,238,.16)}\n103\t.nbtn:focus-visible,.dot:focus-visible{outline:2px solid var(--hlink);outline-offset:2px}\n104\t.count{font-variant-numeric:tabular-nums;min-width:58px;text-align:center;opacity:.85;white-space:nowrap}\n105\t.sep{width:1px;height:18px;background:rgba(195,215,238,.24)}\n106\t.progress{position:fixed;top:0;left:0;right:0;height:2px;z-index:64;background:rgba(195,215,238,.16)}\n107\t.progress i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--accent6),var(--accent5));transition:width .5s cubic-bezier(.22,.7,.2,1)}\n108\t.sfoot{position:absolute;left:92px;right:92px;top:852px;height:16px;display:flex;justify-content:space-between;align-items:center;\n109\t  font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-faint);z-index:6;pointer-events:none}\n110\t.slide[data-theme=\"dark\"]>.sfoot,.slide[data-theme=\"light\"]>.sfoot{position:absolute;z-index:6}\n111\t.slide[data-theme=\"dark\"] .sfoot{color:rgba(195,215,238,.52)}\n112\t.sfoot b{font-weight:600;color:var(--accent5)}\n113\t\n114\t/* ---------- 3 · TIPOGRAFIA ---------- */\n115\th1,h2,h3,h4{font-family:var(--font-heading);margin:0;font-weight:700;letter-spacing:-.012em}\n116\tp{margin:0}\n117\t.eyebrow{font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--accent5);display:flex;align-items:center;gap:10px}\n118\t.eyebrow::before{content:\"\";width:26px;height:2px;background:var(--accent5);flex:0 0 auto}\n119\t.slide[data-theme=\"dark\"] .eyebrow{color:var(--accent6)}\n120\t.slide[data-theme=\"dark\"] .eyebrow::before{background:var(--accent6)}\n121\th2.sh{font-size:40px;line-height:1.12;margin:12px 0 0;max-width:1300px;text-wrap:balance}\n122\t.lede{font-size:18px;line-height:1.55;color:var(--ink-soft);max-width:1240px;margin-top:10px}\n123\t.slide[data-theme=\"dark\"] .lede{color:rgba(219,231,247,.86)}\n124\t.takeaway{margin-top:auto;padding-top:12px;border-top:1px solid var(--rule);font-size:16px;line-height:1.5;color:var(--ink-soft)}\n125\t.takeaway b{color:var(--accent5);font-weight:700}\n126\t.slide[data-theme=\"dark\"] .takeaway{border-top-color:rgba(195,215,238,.2);color:rgba(219,231,247,.84)}\n127\t.num{font-family:var(--font-heading);font-weight:800;letter-spacing:-.03em;font-variant-numeric:tabular-nums;line-height:.92}\n128\t.unit{font-size:.52em;font-weight:700;letter-spacing:0;margin-left:2px;opacity:.72}\n129\t.src{font-size:12px;color:var(--ink-faint);margin-top:6px;letter-spacing:.02em}\n130\t\n131\t/* ---------- 4 · CAPA ---------- */\n132\t.t-cover{justify-content:flex-end;padding:74px 92px 100px}\n133\t.t-cover .kicker{font-size:12.5px;font-weight:700;letter-spacing:.28em;text-transform:uppercase;color:var(--accent6);margin-bottom:26px}\n134\t.t-cover h1{text-wrap:balance;font-size:68px;line-height:1.02;font-weight:800;letter-spacing:-.028em;max-width:960px;position:relative;width:fit-content}\n135\t.t-cover h1 .l2{display:block;color:var(--accent3)}\n136\t.t-cover .csub{font-size:18px;line-height:1.55;color:rgba(219,231,247,.9);max-width:900px;margin-top:26px}\n137\t.t-cover .cmeta{margin-top:32px;display:flex;align-items:stretch;font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;color:rgba(195,215,238,.78)}\n138\t.t-cover .cmeta>span{padding:0 22px;border-left:1px solid rgba(195,215,238,.3)}\n139\t.t-cover .cmeta>span:first-child{padding-left:0;border-left:0}\n140\t.rule{width:88px;height:4px;background:var(--accent5);margin:28px 0 0}\n141\t.slide.active .rule{animation:ruleGrow .8s cubic-bezier(.22,.7,.2,1) .55s both}\n142\t@keyframes ruleGrow{from{width:0}to{width:88px}}\n143\t.t-cover.active h1::after{content:\"\";position:absolute;inset:-7% -5%;pointer-events:none;\n144\t  background:linear-gradient(105deg,transparent 30%,rgba(255,255,255,.15) 48%,transparent 66%);background-size:260% 100%;\n145\t  -webkit-mask-image:linear-gradient(to right,transparent,#000 15%,#000 85%,transparent);mask-image:linear-gradient(to right,transparent,#000 15%,#000 85%,transparent);\n146\t  animation:sheen 7.5s ease-in-out 1.6s infinite backwards}\n147\t@keyframes sheen{0%{background-position:150% 0}55%,100%{background-position:-90% 0}}\n148\t.slide.t-cover>.cover-score{position:absolute;right:92px;top:120px;width:380px;z-index:3;display:flex;flex-direction:column;gap:12px}\n149\t.cs-row{background:rgba(6,30,72,.66);border:1px solid rgba(195,215,238,.22);border-radius:12px;padding:16px 18px;backdrop-filter:blur(6px)}\n150\t.cs-row .who{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:rgba(195,215,238,.8);font-weight:700}\n151\t.cs-row .val{font-family:var(--font-heading);font-size:46px;font-weight:800;letter-spacing:-.03em;margin-top:6px;font-variant-numeric:tabular-nums}\n152\t.cs-row .bar{height:6px;border-radius:0 3px 3px 0;margin-top:10px;background:rgba(195,215,238,.12);overflow:hidden}\n153\t.cs-row .bar i{display:block;height:100%;border-radius:0 3px 3px 0;transform-origin:0 50%}\n154\t.slide.active .cs-row .bar i{animation:kvhIn 1.1s cubic-bezier(.22,.7,.2,1) .5s both}\n155\t.cs-row .note{font-size:12px;color:rgba(219,231,247,.72);margin-top:8px}\n156\t\n157\t/* ---------- 5 · DIVISÓRIA ---------- */\n158\t.t-div{justify-content:center;overflow:hidden}\n159\t.t-div .dnum{font-family:var(--font-heading);font-size:132px;font-weight:800;line-height:.92;color:rgba(195,215,238,.16);letter-spacing:-.04em;margin-bottom:8px}\n160\t.t-div.active .dnum{animation:dnumIn 1.1s cubic-bezier(.22,.7,.2,1) both}\n161\t@keyframes dnumIn{from{opacity:0;transform:translateY(26px) scale(1.14);letter-spacing:.06em}to{opacity:1;transform:none;letter-spacing:-.04em}}\n162\t.t-div .eyebrow{margin-bottom:16px}\n163\t.t-div h1{font-size:68px;line-height:1.02;font-weight:800;letter-spacing:-.026em;max-width:980px}\n164\t.t-div .dsub{margin-top:22px;font-size:18px;line-height:1.6;color:rgba(219,231,247,.86);max-width:860px}\n165\t.t-div.active::after{content:\"\";position:absolute;top:-30%;bottom:-30%;width:36%;left:-40%;z-index:1;pointer-events:none;\n166\t  background:linear-gradient(100deg,transparent,rgba(126,160,235,.16) 42%,rgba(191,210,242,.24) 52%,rgba(126,160,235,.14) 62%,transparent);\n167\t  filter:blur(14px);animation:beam 3.4s cubic-bezier(.3,.6,.25,1) .25s both}\n168\t@keyframes beam{from{left:-45%;opacity:0}25%{opacity:1}to{left:118%;opacity:0}}\n169\t.dchips{margin-top:32px;display:flex;gap:10px;flex-wrap:wrap}\n170\t.chip{font-size:12px;font-weight:600;letter-spacing:.06em;padding:7px 14px;border-radius:999px;border:1px solid rgba(195,215,238,.34);color:rgba(219,231,247,.9)}\n171\t.chip.on{background:rgba(67,170,160,.18);border-color:rgba(67,170,160,.6);color:#BFF3EC}\n172\t.lchip{display:inline-flex;font-size:11.5px;font-weight:700;letter-spacing:.06em;padding:4px 10px;border-radius:999px;\n173\t  background:var(--mist-2);border:1px solid var(--rule);color:var(--ink-soft)}\n174\t\n175\t/* ---------- 6 · KPIs ---------- */\n176\t.kgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:22px}\n177\t.kgrid.k3{grid-template-columns:repeat(3,1fr)}\n178\t.kgrid.k2{grid-template-columns:repeat(2,1fr)}\n179\t.kcard{background:var(--mist);border:1px solid var(--rule);border-radius:10px;padding:16px 18px 14px;display:flex;flex-direction:column;\n180\t  justify-content:space-between;min-height:118px;position:relative;overflow:hidden;transition:transform .3s ease,box-shadow .3s ease}\n181\t.kcard::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--accent1)}\n182\thtml[data-theme-mode=\"dark\"] .kcard::before{background:var(--c1)}\n183\t.kcard.acc::before{background:var(--accent5)}\n184\t.kcard.pos::before{background:var(--accent6)}\n185\t.kcard:hover{transform:translateY(-3px);box-shadow:0 10px 26px rgba(0,20,60,.1)}\n186\t.kcard .num{font-size:52px;color:var(--num1);white-space:nowrap}\n187\t.kcard.acc .num{color:var(--accent5)}\n188\t.kcard.pos .num{color:var(--pos)}\n189\t.kcard .klab{font-size:15px;font-weight:600;line-height:1.3;margin-top:10px;color:var(--ink)}\n190\t.kcard .ksub{font-size:13px;line-height:1.35;color:var(--ink-faint);margin-top:4px}\n191\t.kgrid.tight .kcard{min-height:0;padding:12px 15px 11px}\n192\t.kgrid.tight .kcard .num{font-size:38px}\n193\t.kgrid.k3.tight .kcard .num{font-size:31px}\n194\t.kgrid.tight .kcard .klab{font-size:14px;margin-top:8px}\n195\t\n196\t/* ---------- 7 · CARDS / COLUNAS ---------- */\n197\t.cards{display:grid;gap:14px;margin-top:20px}\n198\t.cards.c2{grid-template-columns:repeat(2,minmax(0,1fr))}\n199\t.cards.c3{grid-template-columns:repeat(3,minmax(0,1fr))}\n200\t.card{background:var(--mist);border:1px solid var(--rule);border-radius:10px;padding:16px 18px 15px;display:flex;flex-direction:column;\n201\t  transition:transform .3s ease,box-shadow .3s ease}\n202\t.card:hover{transform:translateY(-3px);box-shadow:0 10px 26px rgba(0,20,60,.1)}\n203\t.card .ctag{font-size:11.5px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--accent5);margin-bottom:8px;display:flex;justify-content:space-between;gap:8px}\n204\t.card .ctag em{font-style:normal;color:var(--ink-faint);letter-spacing:.08em}\n205\t.card h3{font-size:20px;line-height:1.22;margin-bottom:9px}\n206\t.card p,.card li{font-size:15px;line-height:1.5;color:var(--ink-soft)}\n207\t.card ul{margin:0;padding-left:19px}\n208\t.card li+li{margin-top:6px}\n209\t.card li b,.card p b{color:var(--ink);font-weight:600}\n210\t.card .cnum{font-family:var(--font-heading);font-weight:800;font-size:28px;line-height:1;color:var(--num1);letter-spacing:-.02em;margin:2px 0 7px;font-variant-numeric:tabular-nums}\n211\t.card.sig{background:linear-gradient(150deg,rgba(67,170,160,.14),rgba(67,170,160,.05));border-color:rgba(67,170,160,.42)}\n212\t.card.sig .ctag{color:var(--pos)}\n213\t.card.flag{background:linear-gradient(150deg,rgba(211,93,0,.11),rgba(211,93,0,.04));border-color:rgba(211,93,0,.4)}\n214\t.card.dk{background:linear-gradient(150deg,#062A5C,#041B3F);border-color:rgba(195,215,238,.24);color:#fff}\n215\t.card.dk h3{color:#fff}.card.dk p,.card.dk li{color:rgba(219,231,247,.86)}.card.dk li b,.card.dk p b{color:#fff}\n216\t.card.dk .ctag{color:var(--accent6)}\n217\t.quote{font-family:var(--font-heading);font-size:18px;line-height:1.38;font-weight:600;color:var(--ink);letter-spacing:-.005em}\n218\t.quote::before{content:\"“\";color:var(--accent5);font-size:30px;line-height:0;vertical-align:-10px;margin-right:3px}\n219\t.qby{font-size:13px;color:var(--ink-faint);margin-top:8px;letter-spacing:.04em}\n220\t.card.dk .quote{color:#fff}.card.dk .qby{color:rgba(195,215,238,.7)}\n221\t.lr{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:20px;flex:1;min-height:0}\n222\t.lr>*{min-height:0;display:flex;flex-direction:column}\n223\t.lr.w58{grid-template-columns:1.32fr 1fr}\n224\t.lr.n58{grid-template-columns:1fr 1.32fr}\n225\t.lr.w64{grid-template-columns:1.6fr 1fr}\n226\t.colh{font-family:var(--font-heading);font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-faint);\n227\t  padding-bottom:8px;margin-bottom:12px;border-bottom:1px solid var(--rule)}\n228\t.colh.a{color:var(--accent5);border-bottom-color:rgba(211,93,0,.42)}\n229\t.colh.b{color:var(--pos);border-bottom-color:rgba(67,170,160,.45)}\n230\t.steps{display:grid;gap:9px}\n231\t.steps.s2{grid-template-columns:repeat(2,minmax(0,1fr))}\n232\t.step{display:flex;gap:14px;align-items:flex-start;background:var(--mist);border:1px solid var(--rule);border-radius:9px;padding:15px 17px}\n233\t.step .sn{flex:0 0 auto;width:30px;hei