------ 8 · GRÁFICOS ---------- */\n265\t.chart{background:var(--mist);border:1px solid var(--rule);border-radius:10px;padding:18px 20px 16px;position:relative;display:flex;flex-direction:column}\n266\t.chart .hbars{flex:1;justify-content:space-evenly}\n267\t.chart h4{font-size:17px;margin-bottom:4px}\n268\t.chart .csub{font-size:13px;color:var(--ink-faint);margin-bottom:12px}\n269\t.hbars{display:flex;flex-direction:column;gap:12px}\n270\t.hb{display:grid;grid-template-columns:var(--lw,170px) 1fr 76px;align-items:center;gap:10px;cursor:default;border-radius:6px;padding:1px 0}\n271\t.hb .hl{font-size:14.5px;color:var(--ink);font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n272\t.hb .ht{height:24px;position:relative}\n273\t.hb .ht i{position:absolute;left:0;top:0;bottom:0;width:var(--w);background:var(--c1);border-radius:0 4px 4px 0;transform-origin:0 50%}\n274\t.hb .ht i.c2{background:var(--c2)}.hb .ht i.c3{background:var(--c3)}.hb .ht i.c4{background:var(--c4)}.hb .ht i.cm{background:var(--c-mute)}\n275\t.slide.active .hb .ht i{animation:kvhIn .8s cubic-bezier(.22,.7,.2,1) both;animation-delay:var(--d,.3s)}\n276\t@keyframes kvhIn{from{transform:scaleX(0)}to{transform:scaleX(1)}}\n277\t.hb b{font-size:14.5px;font-variant-numeric:tabular-nums;color:var(--ink);text-align:right;font-weight:700}\n278\t.hb:hover{background:rgba(42,84,181,.06)}\n279\t.hb .ht .ref{position:absolute;top:-4px;bottom:-4px;width:0;border-left:1.5px dashed var(--axis);left:var(--x)}\n280\t.hbars.thin .hb .ht{height:18px}\n281\t.legend{display:flex;gap:16px;font-size:13px;color:var(--ink-soft);margin-top:10px;flex-wrap:wrap}\n282\t.legend span{display:inline-flex;align-items:center;gap:6px}\n283\t.legend i{width:12px;height:10px;border-radius:2px;display:inline-block}\n284\t.legend i.dash{height:0;border-top:1.5px dashed var(--axis);width:16px;border-radius:0}\n285\t.dumb{display:flex;flex-direction:column;gap:16px;margin-top:6px}\n286\t.db{display:grid;grid-template-columns:140px 1fr 100px;gap:10px;align-items:center;font-size:14.5px}\n287\t.db .dt{position:relative;height:20px}\n288\t.db .dt::before{content:\"\";position:absolute;left:0;right:0;top:9px;height:2px;background:var(--grid)}\n289\t.db .seg{position:absolute;top:8px;height:4px;background:var(--c-mute);left:var(--a);width:calc(var(--b) - var(--a));border-radius:2px}\n290\t.db .p{position:absolute;top:3px;width:14px;height:14px;border-radius:50%;margin-left:-7px;border:2px solid var(--paper);box-shadow:0 0 0 1px var(--rule)}\n291\t.db .p.a{left:var(--a);background:var(--c-mute)}.db .p.b{left:var(--b);background:var(--c1)}\n292\t.slide.active .db .p.b{animation:kvdIn .5s cubic-bezier(.3,1.55,.5,1) both;animation-delay:var(--d,.5s)}\n293\t@keyframes kvdIn{from{transform:scale(.2);opacity:0}to{transform:scale(1);opacity:1}}\n294\t.db b{text-align:right;font-variant-numeric:tabular-nums}\n295\tsvg.line{display:block;width:100%;height:auto;overflow:visible}\n296\tsvg.line .gl{stroke:var(--grid);stroke-width:1}\n297\tsvg.line .ax{fill:var(--ink-faint);font-size:12.5px;font-family:var(--font-body)}\n298\tsvg.line .ln{fill:none;stroke:var(--c1);stroke-width:2.2;stroke-linejoin:round;stroke-linecap:round}\n299\t.slide.active svg.line .ln{stroke-dasharray:900;animation:draw 1.4s cubic-bezier(.25,.75,.2,1) .3s both}\n300\t@keyframes draw{from{stroke-dashoffset:900}to{stroke-dashoffset:0}}\n301\tsvg.line .mk{fill:var(--c1);stroke:var(--mist);stroke-width:2}\n302\tsvg.line .mk.last{fill:var(--accent5)}\n303\tsvg.line .ref{stroke:var(--axis);stroke-width:1.5;stroke-dasharray:5 4}\n304\tsvg.line .lbl{fill:var(--ink);font-size:13px;font-weight:700;font-family:var(--font-body)}\n305\tsvg.line .hit{fill:transparent;cursor:crosshair}\n306\tsvg.line .xh{stroke:var(--axis);stroke-width:1;opacity:0}\n307\t.stack{display:flex;height:30px;border-radius:6px;overflow:hidden;gap:2px;margin-top:6px}\n308\t.stack i{display:block;height:100%;background:var(--c1)}\n309\t.stack i.c2{background:var(--c2)}.stack i.c3{background:var(--c3)}\n310\t#tip{position:fixed;z-index:300;pointer-events:none;background:#0A1C3F;color:#EAF1FB;font-size:12px;line-height:1.4;\n311\t  padding:8px 11px;border-radius:8px;box-shadow:0 10px 30px rgba(0,0,0,.3);border:1px solid rgba(195,215,238,.25);\n312\t  opacity:0;transform:translateY(4px);transition:opacity .15s,transform .15s;max-width:280px}\n313\t#tip.on{opacity:1;transform:none}\n314\t#tip b{color:#fff}\n315\t\n316\t/* ---------- 9 · VISÃO GERAL / DICA ---------- */\n317\t#ov{position:fixed;inset:0;z-index:180;background:rgba(2,8,22,.95);display:none;padding:52px 46px 40px;overflow:auto}\n318\t#ov.on{display:block}\n319\t#ov h3{color:#fff;font-size:19px;margin-bottom:5px}\n320\t#ov .ovh{color:rgba(195,215,238,.6);font-size:12px;letter-spacing:.1em;margin-bottom:22px}\n321\t#ovg{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:13px}\n322\t.ovc{background:rgba(195,215,238,.07);border:1px solid rgba(195,215,238,.2);border-radius:8px;padding:12px 14px;cursor:pointer;transition:all .2s;text-align:left;font-family:inherit}\n323\t.ovc:hover{background:rgba(67,170,160,.16);border-color:rgba(67,170,160,.5);transform:translateY(-2px)}\n324\t.ovc.on{border-color:var(--accent5);background:rgba(211,93,0,.16)}\n325\t.ovc .on2{font-family:var(--font-heading);font-size:11px;font-weight:700;color:var(--accent6);letter-spacing:.1em;display:block;margin-bottom:5px}\n326\t.ovc .ot{color:#EAF1FB;font-size:12.5px;line-height:1.35;font-weight:500;display:block}\n327\t#hint{position:fixed;left:50%;bottom:60px;transform:translateX(-50%);z-index:70;background:rgba(4,16,42,.86);color:#DCE7F7;font-size:12px;\n328\t  padding:8px 14px;border-radius:999px;border:1px solid rgba(195,215,238,.2);opacity:0;transition:opacity .4s;pointer-events:none;white-space:nowrap}\n329\t#hint.on{opacity:1}\n330\t\n331\t/* ---------- 10 · LEITURA EM TELA ESTREITA (celular) E IMPRESSÃO ---------- */\n332\thtml.mobile,html.mobile body{height:auto;overfl