\n      ring:i<N*.42, tx:1230+Math.cos(a)*rr*(0.96+Math.random()*.08), ty:440+Math.sin(a)*rr*(0.96+Math.random()*.08), ph:Math.random()*6.28});\n  }\n  function frame(ts){\n    if (!running) return;\n    var t=ts/1000; ctx.clearRect(0,0,W,H);\n    for (var i=0;i<N;i++){\n      var p=pts[i];\n      if (ring && p.ring){\n        var ang=t*.05*(p.z>.6?1:-1), cx=1230, cy=440, dx=p.tx-cx, dy=p.ty-cy;\n        var gx=cx+dx*Math.cos(ang)-dy*Math.sin(ang), gy=cy+dx*Math.sin(ang)+dy*Math.cos(ang);\n        p.x+=(gx-p.x)*.03; p.y+=(gy-p.y)*.03;\n      } else {\n        p.x+=p.vx*p.z*1.4; p.y+=p.vy*p.z*1.4;\n        if(p.x<-10)p.x=W+10; if(p.x>W+10)p.x=-10; if(p.y<-10)p.y=H+10; if(p.y>H+10)p.y=-10;\n      }\n      var al=(.18+.55*p.z)*(.75+.25*Math.sin(t*1.3+p.ph));\n      ctx.fillStyle=p.ring&&ring ? 'rgba(143,180,236,'+al+')' : 'rgba(195,215,238,'+(al*.8)+')';\n      ctx.beginPath(); ctx.arc(p.x,p.y,.6+1.5*p.z,0,6.283); ctx.fill();\n    }\n    requestAnimationFrame(frame);\n  }\n  function start(){ if(!running && show && !reduce && !document.hidden && !root.classList.contains('mobile')){ running=true; requestAnimationFrame(frame);} }\n  function stop(){ running=false; }\n  document.addEventListener('visibilitychange',function(){ document.hidden?stop():start(); });\n  if (reduce){ /* um quadro estático */ ctx.fillStyle='rgba(195,215,238,.4)'; pts.forEach(function(p){ctx.beginPath();ctx.arc(p.x,p.y,1,0,6.283);ctx.fill();}); }\n  return { setMode:function(dark,r){ show=dark; ring=r; if(show) start(); else { stop(); ctx.clearRect(0,0,W,H);} } };\n})();\n\n\n/* ---------- selo de destaque + navegação que se recolhe ---------- */\nvar TIERN={'1':'1º destaque · Tecnologia e IA','2':'2º destaque · Economia e mercados','3':'3º destaque · Política e demais temas'};\nslides.forEach(function(s,i){\n  var t=s.dataset.tier; if(!t) return;\n  if (s.dataset.theme==='light'){ var p=document.createElement('div'); p.className='tierpill t'+t; p.innerHTML='<i></i>'+TIERN[t]; s.insertBefore(p,s.firstChild); }\n  if (dotsBox.children[i]) dotsBox.children[i].classList.add('t'+t);\n});\nvar idleT=null;\nfunction wake(){ document.body.classList.remove('idle'); clearTimeout(idleT); idleT=setTimeout(function(){ if(!document.querySelector('.nav:hover')) document.body.classList.add('idle'); },2600); }\n['mousemove','keydown','touchstart'].forEach(function(ev){ document.addEventListener(ev,wake,{passive:true}); });\nwake();\n\nfitStage(); update();\nvar hint=document.getElementById('hint');\nif (!root.classList.contains('mobile')){ setTimeout(function(){hint.classList.add('on');},900); setTimeout(function(){hint.classList.remove('on');},5200); }\n})();\n</script>","numLines":180,"startLine":833,"totalLines":1015}}}
