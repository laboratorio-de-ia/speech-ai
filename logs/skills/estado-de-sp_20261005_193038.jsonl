.slide[data-theme=\"light\"]::before{\n  background:radial-gradient(58% 80% at 100% 0%,rgba(92,130,220,.16) 0%,rgba(92,130,220,0) 62%),\n             radial-gradient(46% 62% at 0% 100%,rgba(18,168,153,.10) 0%,rgba(18,168,153,0) 60%)}\n.slide[data-theme=\"light\"]>*{position:relative;z-index:2}\n\n/* entrada escalonada: estado de repouso é VISÍVEL; o oculto vive só nos keyframes */\n.slide.active .rv{animation:rvIn .5s cubic-bezier(.22,.7,.2,1) both}\n.slide.active .rv:nth-child(1){animation-delay:.05s}.slide.active .rv:nth-child(2){animation-delay:.12s}\n.slide.active .rv:nth-child(3){animation-delay:.19s}.slide.active .rv:nth-child(4){animation-delay:.26s}\n.slide.active .rv:nth-child(5){animation-delay:.33s}.slide.active .rv:nth-child(6){animation-delay:.40s}\n@keyframes rvIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}\n.slide.active .fan>*{animation:fanIn .42s cubic-bezier(.22,.7,.2,1) both}\n@keyframes fanIn{from{opacity:0;transform:translateY(14px) scale(.985)}to{opacity:1;transform:none}}\n.slide.active .fan>*:nth-child(1){animation-delay:.14s}.slide.active .fan>*:nth-child(2){animation-delay:.18s}\n.slide.active .fan>*:nth-child(3){animation-delay:.22s}.slide.active .fan>*:nth-child(4){animation-delay:.26s}\n.slide.active .fan>*:nth-child(5){animation-delay:.30s}.slide.active .fan>*:nth-child(6){animation-delay:.34s}\n.slide.active .fan>*:nth-child(7){animation-delay:.38s}.slide.active .fan>*:nth-child(8){animation-delay:.42s}\n.slide.active .fan>*:nth-child(n+9){animation-delay:.46s}\nbody.no-motion .slide.active .rv,body.no-motion .slide.active .fan>*{animation:none}\n.deck::after{content:\"\";position:absolute;inset:0;pointer-events:none;z-index:40;opacity:.035;\n  background-image:url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3'/></filter><rect width='120' height='120' filter='url(%23n)'/></svg>\")}\n\n/* ---------- 2 · CROMO: marca, navegação, progresso, rodapé ---------- */\n.brand{position:absolute;top:22px;left:50%;transform:translateX(-50%);z-index:55;pointer-events:none;\n  font-family:var(--font-heading);font-size:11px;font-weight:700;letter-spacing:.32em;text-transform:uppercase;\n  color:rgba(195,215,238,.72);display:flex;align-items:center;gap:10px;white-space:nowrap}\n.brand i{width:7px;height:7px;border-radius:50%;background:var(--accent5);display:block}\n.brand.on-light{color:#46526E}\n.nav{position:fixed;bottom:14px;left:50%;transform:translateX(-50%);z-index:62;display:flex;align-items:center;gap:13px;\n  padding:7px 15px;border-radius:999px;background:rgba(4,16,42,.74);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);\n  border:1px solid rgba(195,215,238,.2);color:#DCE7F7;font-family:var(--font-body);font-size:11px;letter-spacing:.06em;\n  opacity:.55;transition:opacity .3s ease}\n.nav:hover,.nav:focus-within{opacity:1}\n.dots{display:flex;gap:5px;align-items:center}\n.dot{width:7px;height:7px;border-radius:50%;border:0;padding:0;cursor:pointer;background:rgba(195,215,238,.34);\n  transition:transform .25s ease,background .25s ease}\n.dot:hover{background:var(--accent3);transform:scale(1.35)}\n.dot.sec{background:rgba(67,170,160,.6)}\n.dot.on{background:var(--accent5);transform:scale(1.5)}\n.nbtn{background:transparent;border:1px solid rgba(195,215,238,.45);color:inherit;border-radius:999px;min-width:30px;height:24px;\n  padding:0 8px;cursor:pointer;font-size:11px;font-weight:600;font-family:var(--font-body);opacity:.85;transition:opacity .2s,background .2s}\n.nbtn:hover{opacity:1;background:rgba(195,215,238,.16)}\n.nbtn:focus-visible,.dot:focus-visible{outline:2px solid var(--hlink);outline-offset:2px}\n.count{font-variant-numeric:tabular-nums;min-width:58px;text-align:center;opacity:.85;white-space:nowrap}\n.sep{width:1px;height:18px;background:rgba(195,215,238,.24)}\n.progress{position:fixed;top:0;left:0;right:0;height:2px;z-index:64;background:rgba(195,215,238,.16)}\n.progress i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--accent6),var(--accent5));transition:width .5s cubic-bezier(.22,.7,.2,1)}\n.sfoot{position:absolute;left:92px;right:92px;top:852px;height:16px;display:flex;justify-content:space-between;align-items:center;\n  font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-faint);z-index:6;pointer-events:none}\n.slide[data-theme=\"dark\"]>.sfoot,.slide[data-theme=\"light\"]>.sfoot{position:absolute;z-index:6}\n.slide[data-theme=\"dark\"] .sfoot{color:rgba(195,215,238,.52)}\n.sfoot b{font-weight:600;color:var(--accent5)}\n\n/* ---------- 3 · TIPOGRAFIA ---------- */\nh1,h2,h3,h4{font-family:var(--font-heading);margin:0;font-weight:700;letter-spacing:-.012em}\np{margin:0}\n.eyebrow{font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--accent5);display:flex;align-items:center;gap:10px}\n.eyebrow::before{content:\"\";width:26px;height:2px;background:var(--accent5);flex:0 0 auto}\n.slide[data-theme=\"dark\"] .eyebrow{color:var(--accent6)}\n.slide[data-theme=\"dark\"] .eyebrow::before{background:var(--accent6)}\nh2.sh{font-size:40px;line-height:1.12;margin:12px 0 0;max-width:1300px;text-wrap:balance}\n.lede{font-size:18px;line-height:1.55;color:var(--ink-soft);max-width:1240px;margin-top:10px}\n.slide[data-theme=\"dark\"] .lede{color:rgba(219,231,247,.86)}\n.takeaway{margin-top:auto;padding-top:12px;border-top:1px solid var(--rule);font-size:16px;line-height:1.5;color:var(--ink-soft)}\n.takeaway b{color:var(--accent5);font-weight:700}\n.slide[data-theme=\"dark\"] .takeaway{border-top-color:rgba(195,215,238,.2);color:rgba(219,231,247,.84)}\n.num{font-family:var(--font-heading);font-weight:800;letter-spacing:-.03em;font-variant-numeric:tabular-nums;line-height:.92}\n.unit{font-size:.52em;font-weight:700;letter-spacing:0;margin-left:2px;opacity:.72}\n.src{font-size:12px;color:var(--ink-faint);margin-top:6px;letter-spacing:.02em}\n\n/* ---------- 4 · CAPA ---------- */\n.t-cover{justify-content:flex-end;padding:74px 92px 100px}\n.t-cover .kicker{font-size:12.5px;font-weight:700;letter-spacing:.28em;text-transform:uppercase;color:var(--accent6);margin-bottom:26px}\n.t-cover h1{text-wrap:balance;font-size:68px;line-height:1.02;font-weight:800;letter-spacing:-.028em;max-width:960px;position:relative;width:fit-content}\n.t-cover h1 .l2{display:block;color:var(--accent3)}\n.t-cover .csub{font-size:18px;line-height:1.55;color:rgba(219,231,247,.9);max-width:900px;margin-top:26px}\n.t-cover .cmeta{margin-top:32px;display:flex;align-items:stretch;font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;color:rgba(195,215,238,.78)}\n.t-cover .cmeta>span{padding:0 22px;border-left:1px solid rgba(195,215,238,.3)}\n.t-cover .cmeta>span:first-child{padding-left:0;border-left:0}\n.rule{width:88px;height:4px;background:var(--accent5);margin:28px 0 0}\n.slide.active .rule{animation:ruleGrow .8s cubic-bezier(.22,.7,.2,1) .55s both}\n@keyframes ruleGrow{from{width:0}to{width:88px}}\n.t-cover.active h1::after{content:\"\";position:absolute;inset:-7% -5%;pointer-events:none;\n  background:linear-gradient(105deg,transparent 30%,rgba(255,255,255,.15) 48%,transparent 66%);background-size:260% 100%;\n  -webkit-mask-image:linear-gradient(to right,transparent,#000 15%,#000 85%,transparent);mask-image:linear-gradient(to right,transparent,#000 15%,#000 85%,transparent);\n  animation:sheen 7.5s ease-in-out 1.6s infinite backwards}\n@keyframes sheen{0%{background-position:150% 0}55%,100%{background-position:-90% 0}}\n.slide.t-cover>.cover-score{position:absolute;right:92px;top:120px;width:380px;z-index:3;display:flex;flex-direction:column;gap:12px}\n.cs-row{background:rgba(6,30,72,.66);border:1px solid rgba(195,215,238,.22);border-radius:12px;padding:16px 18px;backdrop-filter:blur(6px)}\n.cs-row .who{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:rgba(195,215,238,.8);font-weight:700}\n.cs-row .val{font-family:var(--font-heading);font-size:46px;font-weight:800;letter-spacing:-.03em;margin-top:6px;font-variant-numeric:tabular-nums}\n.cs-row .bar{height:6px;border-radius:0 3px 3px 0;margin-top:10px;background:rgba(195,215,238,.12);overflow:hidden}\n.cs-row .bar i{display:block;height:100%;border-radius:0 3px 3px 0;transform-origin:0 50%}\n.slide.active .cs-row .bar i{animation:kvhIn 1.1s cubic-bezier(.22,.7,.2,1) .5s both}\n.cs-row .note{font-size:12px;color:rgba(219,231,247,.72);margin-top:8px}\n\n/* ---------- 5 · DIVISÓRIA ---------- */\n.t-div{justify-content:center;overflow:hidden}\n.t-div .dnum{font-family:var(--font-heading);font-size:132px;font-weight:800;line-height:.92;color:rgba(195,215,238,.16);letter-spacing:-.04em;margin-bottom:8px}\n.t-div.active .dnum{animation:dnumIn 1.1s cubic-bezier(.22,.7,.2,1) both}\n@keyframes dnumIn{from{opacity:0;transform:translateY(26px) scale(1.14);letter-spacing:.06em}to{opacity:1;transform:none;letter-spacing:-.04em}}\n.t-div .eyebrow{margin-bottom:16px}\n.t-div h1{font-size:68px;line-height:1.02;font-weight:800;letter-spacing:-.026em;max-width:980px}\n.t-div .dsub{margin-top:22px;font-size:18px;line-height:1.6;color:rgba(219,231,247,.86);max-width:860px}\n.t-div.active::after{content:\"\";position:absolute;top:-30%;bottom:-30%;width:36%;left:-40%;z-index:1;pointer-events:none;\n  background:linear-gradient(100deg,transparent,rgba(126,160,235,.16) 42%,rgba(191,210,242,.24) 52%,rgba(126,160,235,.14) 62%,transparent);\n  filter:blur(14px);animation:beam 3.4s cubic-bezier(.3,.6,.25,1) .25s both}\n@keyframes beam{from{left:-45%;opacity:0}25%{opacity:1}to{left:118%;opacity:0}}\n.dchips{margin-top:32px;display:flex;gap:10px;flex-wrap:wrap}\n.chip{font-size:12px;font-weight:600;letter-spacing:.06em;padding:7px 14px;border-radius:999px;border:1px solid rgba(195,215,238,.34);color:rgba(219,231,247,.9)}\n.chip.on{background:rgba(67,170,160,.18);border-color:rgba(67,170,160,.6);color:#BFF3EC}\n.lchip{display:inline-flex;font-size:11.5px;font-weight:700;letter-spacing:.06em;padding:4px 10px;border-radius:999px;\n  background:var(--mist-2);border:1px solid var(--rule);color:var(--ink-soft)}\n\n/* ---------- 6 · KPIs ---------- */\n.kgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:22px}\n.kgrid.k3{grid-template-columns:repeat(3,1fr)}\n.kgrid.k2{grid-template-columns:repeat(2,1fr)}\n.kcard{background:var(--mist);border:1px solid var(--rule);border-radius:10px;padding:16px 18px 14px;display:flex;flex-direction:column;\n  justify-content:space-between;min-height:118px;position:relative;overflow:hidden;transition:transform .3s ease,box-shadow .3s ease}\n.kcard::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--accent1)}\nhtml[data-theme-mode=\"dark\"] .kcard::before{background:var(--c1)}\n.kcard.acc::before{background:var(--accent5)}\n.kcard.pos::before{background:var(--accent6)}\n.kcard:hover{transform:translateY(-3px);box-shadow:0 10px 26px rgba(0,20,60,.1)}\n.kcard .num{font-size:52px;color:var(--num1);white-space:nowrap}\n.kcard.acc .num{color:var(--accent5)}\n.kcard.pos .num{color:var(--pos)}\n.kcard .klab{font-size:15px;font-weight:600;line-height:1.3;margin-top:10px;color:var(--ink)}\n.kcard .ksub{font-size:13px;line-height:1.35;color:var(--ink-faint);margin-top:4px}\n.kgrid.tight .kcard{min-height:0;padding:12px 15px 11px}\n.kgrid.tight .kcard .num{font-size:38px}\n.kgrid.k3.tight .kcard .num{font-size:31px}\n.kgrid.tight .kcard .klab{font-size:14px;margin-top:8px}\n\n/* ---------- 7 · CARDS / COLUNAS ---------- */\n.cards{display:grid;gap:14px;margin-top:20px}\n.cards.c2{grid-template-columns:repeat(2,minmax(0,1fr))}\n.cards.c3{grid-template-columns:repeat(3,minmax(0,1fr))}\n.card{background:var(--mist);border:1px solid var(--rule);border-radius:10px;padding:16px 18px 15px;display:flex;flex-direction:column;\n  transition:transform .3s ease,box-shadow .3s ease}\n.card:hover{transform:translateY(-3px);box-shadow:0 10px 26px rgba(0,20,60,.1)}\n.card .ctag{font-size:11.5px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--accent5);margin-bottom:8px;display:flex;justify-content:space-between;gap:8px}\n.card .ctag em{font-style:normal;color:var(--ink-faint);letter-spacing:.08em}\n.card h3{font-size:20px;line-height:1.22;margin-bottom:9px}\n.card p,.card li{font-size:15px;line-height:1.5;color:var(--ink-soft)}\n.card ul{margin:0;padding-left:19px}\n.card li+li{margin-top:6px}\n.card li b,.card p b{color:var(--ink);font-weight:600}\n.card .cnum{font-family:var(--font-heading);font-weight:800;font-size:28px;line-height:1;color:var(--num1);letter-spacing:-.02em;margin:2px 0 7px;font-variant-numeric:tabular-nums}\n.card.sig{background:linear-gradient(150deg,rgba(67,170,160,.14),rgba(67,170,160,.05));border-color:rgba(67,170,160,.42)}\n.card.sig .ctag{color:var(--pos)}\n.card.flag{background:linear-gradient(150deg,rgba(211,93,0,.11),rgba(211,93,0,.04));border-color:rgba(211,93,0,.4)}\n.card.dk{background:linear-gradient(150deg,#062A5C,#041B3F);border-color:rgba(195,215,238,.24);color:#fff}\n.card.dk h3{color:#fff}.card.dk p,.card.dk li{color:rgba(219,231,247,.86)}.card.dk li b,.card.dk p b{color:#fff}\n.card.dk .ctag{color:var(--accent6)}\n.quote{font-family:var(--font-heading);font-size:18px;line-height:1.38;font-weight:600;color:var(--ink);letter-spacing:-.005em}\n.quote::before{content:\"“\";color:var(--accent5);font-size:30px;line-height:0;vertical-align:-10px;margin-right:3px}\n.qby{font-size:13px;color:var(--ink-faint);margin-top:8px;letter-spacing:.04em}\n.card.dk .quote{color:#fff}.card.dk .qby{color:rgba(195,215,238,.7)}\n.lr{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:20px;flex:1;min-height:0}\n.lr>*{min-height:0;display:flex;flex-direction:column}\n.lr.w58{grid-template-columns:1.32fr 1fr}\n.lr.n58{grid-template-columns:1fr 1.32fr}\n.lr.w64{grid-template-columns:1.6fr 1fr}\n.colh{font-family:var(--font-heading);font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-faint);\n  padding-bottom:8px;margin-bottom:12px;border-bottom:1px solid var(--rule)}\n.colh.a{color:var(--accent5);border-bottom-color:rgba(211,93,0,.42)}\n.colh.b{color:var(--pos);border-bottom-color:rgba(67,170,160,.45)}\n.steps{display:grid;gap:9px}\n.steps.s2{grid-template-columns:repeat(2,minmax(0,1fr))}\n.step{display:flex;gap:14px;align-items:flex-start;background:var(--mist);border:1px solid var(--rule);border-radius:9px;padding:15px 17px}\n.step .sn{flex:0 0 auto;width:30px;height:30px;border-radius:50%;background:var(--accent1);color:#fff;font-family:var(--font-heading);\n  font-weight:700;font-size:12px;display:grid;place-items:center;margin-top:1px}\nhtml[data-theme-mode=\"dark\"] .step .sn{background:var(--c1)}\n.step.o .sn{background:var(--accent5)}\n.step.g .sn{background:var(--accent6)}\n.step h4{font-size:17px;line-height:1.25;margin-bottom:4px}\n.step p{font-size:14.5px;line-height:1.45;color:var(--ink-soft)}\n.vs{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n.mini{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}\n.pill{font-size:13.5px;padding:6px 11px;border-radius:8px;background:var(--mist-2);border:1px solid var(--rule);color:var(--ink-soft)}\n.pill b{color:var(--ink)}\n\n.fill{flex:1;min-height:0;grid-auto-rows:1fr}\n.big .card{padding:20px 22px 18px}\n.big .card p,.big .card li{font-size:16.5px;line-height:1.5}\n.big .card h3{font-size:22px}\n.big .card .ctag{font-size:12px}\n.big .quote{font-size:19px}\n.steps.fill .step{align-items:center}\n.big .step h4{font-size:18px}.big .step p{font-size:15.5px}\n.kgrid.tall .kcard{min-height:150px}\n.kgrid.tall .kcard .num{font-size:58px}\n/* tabela compacta */\n.tbl{width:100%;border-collapse:collapse;font-size:14px}\n.tbl th{font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-faint);text-align:left;font-weight:700;padding:0 8px 7px;border-bottom:1px solid var(--rule)}\n.tbl td{padding:9px 8px;border-bottom:1px solid var(--rule);color:var(--ink-soft);vertical-align:top}\n.tbl td:first-child{font-weight:700;color:var(--ink);font-family:var(--font-heading);font-size:13.5px;white-space:nowrap}\n.tbl td.n{text-align:right;font-variant-numeric:tabular-nums;color:var(--ink);font-weight:600;white-space:nowrap}\n.tbl th.n{text-align:right}\n.tbl tr:hover td{background:rgba(42,84,181,.05)}\n\n/* ---------- 8 · GRÁFICOS ---------- */\n.chart{background:var(--mist);border:1px solid var(--rule);border-radius:10px;padding:18px 20px 16px;position:relative;display:flex;flex-direction:column}\n.chart .hbars{flex:1;justify-content:space-evenly}\n.chart h4{font-size:17px;margin-bottom:4px}\n.chart .csub{font-size:13px;color:var(--ink-faint);margin-bottom:12px}\n.hbars{display:flex;flex-direction:column;gap:12px}\n.hb{display:grid;grid-template-columns:var(--lw,170px) 1fr 76px;align-items:center;gap:10px;cursor:default;border-radius:6px;padding:1px 0}\n.hb .hl{font-size:14.5px;color:var(--ink);font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.hb .ht{height:24px;position:relative}\n.hb .ht i{position:absolute;left:0;top:0;bottom:0;width:var(--w);background:var(--c1);border-radius:0 4px 4px 0;transform-origin:0 50%}\n.hb .ht i.c2{background:var(--c2)}.hb .ht i.c3{background:var(--c3)}.hb .ht i.c4{background:var(--c4)}.hb .ht i.cm{background:var(--c-mute)}\n.slide.active .hb .ht i{animation:kvhIn .8s cubic-bezier(.22,.7,.2,1) both;animation-delay:var(--d,.3s)}\n@keyframes kvhIn{from{transform:scaleX(0)}to{transform:scaleX(1)}}\n.hb b{font-size:14.5px;font-variant-numeric:tabular-nums;color:var(--ink);text-align:right;font-weight:700}\n.hb:hover{background:rgba(42,84,181,.06)}\n.hb .ht .ref{position:absolute;top:-4px;bottom:-4px;width:0;border-left:1.5px dashed var(--axis);left:var(--x)}\n.hbars.thin .hb .ht{height:18px}\n.legend{display:flex;gap:16px;font-size:13px;color:var(--ink-soft);margin-top:10px;flex-wrap:wrap}\n.legend span{display:inline-flex;align-items:center;gap:6px}\n.legend i{width:12px;height:10px;border-radius:2px;display:inline-block}\n.legend i.dash{height:0;border-top:1.5px dashed var(--axis);width:16px;border-radius:0}\n.dumb{display:flex;flex-direction:column;gap:16px;margin-top:6px}\n.db{display:grid;grid-template-columns:140px 1fr 100px;gap:10px;align-items:center;font-size:14.5px}\n.db .dt{position:relative;height:20px}\n.db .dt::before{content:\"\";position:absolute;left:0;right:0;top:9px;height:2px;background:var(--grid)}\n.db .seg{position:absolute;top:8px;height:4px;background:var(--c-mute);left:var(--a);width:calc(var(--b) - var(--a));border-radius:2px}\n.db .p{position:absolute;top:3px;width:14px;height:14px;border-radius:50%;margin-left:-7px;border:2px solid var(--paper);box-shadow:0 0 0 1px var(--rule)}\n.db .p.a{left:var(--a);background:var(--c-mute)}.db .p.b{left:var(--b);background:var(--c1)}\n.slide.active .db .p.b{animation:kvdIn .5s cubic-bezier(.3,1.55,.5,1) both;animation-delay:var(--d,.5s)}\n@keyframes kvdIn{from{transform:scale(.2);opacity:0}to{transform:scale(1);opacity:1}}\n.db b{text-align:right;font-variant-numeric:tabular-nums}\nsvg.line{display:block;width:100%;height:auto;overflow:visible}\nsvg.line .gl{stroke:var(--grid);stroke-width:1}\nsvg.line .ax{fill:var(--ink-faint);font-size:12.5px;font-family:var(--font-body)}\nsvg.line .ln{fill:none;stroke:var(--c1);stroke-width:2.2;stroke-linejoin:round;stroke-linecap:round}\n.slide.active svg.line .ln{stroke-dasharray:900;animation:draw 1.4s cubic-bezier(.25,.75,.2,1) .3s both}\n@keyframes draw{from{stroke-dashoffset:900}to{stroke-dashoffset:0}}\nsvg.line .mk{fill:var(--c1);stroke:var(--mist);stroke-width:2}\nsvg.line .mk.last{fill:var(--accent5)}\nsvg.line .ref{stroke:var(--axis);stroke-width:1.5;stroke-dasharray:5 4}\nsvg.line .lbl{fill:var(--ink);font-size:13px;font-weight:700;font-family:var(--font-body)}\nsvg.line .hit{fill:transparent;cursor:crosshair}\nsvg.line .xh{stroke:var(--axis);stroke-width